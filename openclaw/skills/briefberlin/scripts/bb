#!/usr/bin/env python3
"""Unprivileged manual workflow client. Only source and image bytes cross the socket."""

import base64
import hashlib
import json
import os
import socket
import stat
import sys
from pathlib import Path


def read_upload(directory, filename, limit):
    if directory.resolve() != directory or filename in {"", ".", ".."} or "/" in filename:
        raise ValueError("upload must be directly inside the configured private inbox")
    dir_fd = os.open(directory, os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        fd = os.open(filename, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
        with os.fdopen(fd, "rb") as upload:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                raise ValueError("upload must be a regular file")
            data = upload.read(limit + 1)
        if len(data) > limit:
            raise ValueError("upload exceeds size limit")
        return data
    finally:
        os.close(dir_fd)


def run(argv):
    action, args = (argv[0], argv[1:]) if argv else ("status", [])
    request = {"action": action, "args": args}
    inbox = Path(os.environ.get("BB_INBOX", "/opt/openclaw/work/inbox"))
    source = inbox / "article.txt"
    data = None
    if action in {"generate", "received"}:
        if args != [str(source)]:
            raise ValueError("use the configured article.txt inbox")
        try:
            data = read_upload(inbox, source.name, 256_000)
        except FileNotFoundError:
            if action != "generate":
                raise
        request["args"] = []
    elif action == "add-image":
        if len(args) not in {3, 4}:
            raise ValueError("usage: bb add-image STORY INBOX_IMAGE ALT [CAPTION]")
        media = Path(os.environ.get("BB_MEDIA_INBOX", str(inbox / "media")))
        path = Path(args[1])
        if path.parent != media:
            raise ValueError("image must be inside the configured media inbox")
        data = read_upload(media, path.name, 800_000)
        request["args"] = [args[0], *args[2:]]
    if data is not None:
        request["content"] = base64.b64encode(data).decode("ascii")
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(7200)
        client.connect(os.environ.get("BB_MANUAL_SOCKET", "/opt/briefberlin-socket/manual.sock"))
        client.sendall(json.dumps(request).encode() + b"\n")
        client.shutdown(socket.SHUT_WR)
        with client.makefile("rb") as response:
            reply = json.loads(response.readline(500_000))
    if reply["ok"]:
        if action == "generate" and data and hashlib.sha256(data).hexdigest() == reply.get("source_hash"):
            if read_upload(inbox, source.name, 256_000) == data:
                source.unlink()
        if action == "cancel":
            source.unlink(missing_ok=True)
    print(reply["result"])
    return 0 if reply["ok"] else 1


if __name__ == "__main__":
    try:
        sys.exit(run(sys.argv[1:]))
    except (OSError, ValueError, KeyError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        sys.exit(1)
