#!/usr/bin/env python3
"""Scoped triage client for the scheduled OpenClaw session."""

import argparse
import json
import os
import socket
import sys


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("op", choices=("claim", "decide"))
    parser.add_argument("id", help="invocation ID for claim, host token for decide")
    args = parser.parse_args()
    request = {"op": args.op}
    if args.op == "claim":
        request["owner"] = args.id
    else:
        raw = sys.stdin.buffer.read(64001)
        if len(raw) > 64000:
            raise ValueError("decision exceeds 64000 bytes")
        request.update(token=args.id, decision=json.loads(raw))
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(45)
        client.connect(os.environ.get("BB_DISCOVERY_SOCKET", "/opt/briefberlin-socket/discovery.sock"))
        client.sendall((json.dumps(request, ensure_ascii=False) + "\n").encode())
        client.shutdown(socket.SHUT_WR)
        with client.makefile("rb") as stream:
            raw = stream.readline(1024 * 1024 + 1)
        if len(raw) > 1024 * 1024 or not raw.endswith(b"\n"):
            raise ValueError("invalid host response")
        response = json.loads(raw)
        if response.get("ok") is not True:
            raise ValueError(response.get("error", "host rejected request"))
        print(json.dumps(response["result"], ensure_ascii=False))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as exc:
        sys.exit(str(exc))
