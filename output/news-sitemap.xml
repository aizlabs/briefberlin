---
layout: null
permalink: /news-sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">
  {%- assign cutoff_seconds = 172800 -%}
  {%- assign current_time = site.time | date: "%s" -%}
  {%- assign articles = site.posts | concat: site.translations -%}
  {%- for article in articles -%}
    {%- if article.date == nil or article.published == false or article.sitemap == false or article.news_sitemap == false -%}
      {%- continue -%}
    {%- endif -%}
    {%- assign article_time = article.date | date: "%s" -%}
    {%- assign age_seconds = current_time | minus: article_time -%}
    {%- if age_seconds >= 0 and age_seconds <= cutoff_seconds %}
    <url>
      <loc>{{ article.url | absolute_url | xml_escape }}</loc>
      <news:news>
        <news:publication>
          <news:name>{{ site.title | xml_escape }}</news:name>
          <news:language>{{ article.lang | default: site.lang | xml_escape }}</news:language>
        </news:publication>
        <news:publication_date>{{ article.date | date_to_xmlschema }}</news:publication_date>
        <news:title>{{ article.title | xml_escape }}</news:title>
      </news:news>
    </url>
    {%- endif -%}
  {%- endfor %}
</urlset>
