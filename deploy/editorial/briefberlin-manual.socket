[Unit]
Description=BriefBerlin scoped manual client socket
ConditionPathIsDirectory=/srv/openclaw-projects/briefberlin-manual/socket

[Socket]
ListenStream=/srv/openclaw-projects/briefberlin-manual/socket/manual.sock
SocketUser=briefberlin
SocketGroup=briefberlin-client
SocketMode=0660
RemoveOnStop=yes
Accept=yes
MaxConnections=8

[Install]
WantedBy=sockets.target
